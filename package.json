{
  "name": "iobroker.creality",
  "version": "0.4.0",
  "description": "Creality 3D-Printer",
  "author": {
    "name": "skvarel",
    "email": "skvarel@inventwo.com"
  },
  "contributors": [
    {
      "name": "skvarel"
    }
  ],
  "homepage": "https://github.com/inventwo/ioBroker.creality",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "creality",
    "3D",
    "Printer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/inventwo/ioBroker.creality.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22.20.1",
    "typescript": "~5.9.3"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "translate": "translate-adapter",
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "adapter-check": "npx --yes @iobroker/repochecker https://github.com/inventwo/ioBroker.creality --local",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/inventwo/ioBroker.creality/issues"
  },
  "readmeFilename": "README.md"
}
